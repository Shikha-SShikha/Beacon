          "beacon:object": "proliferation of T. annulata -infected leukocytes",
          "beacon:evidence": "m6A might be a key factor driving the persistent proliferation of T. annulata -infected leukocytes"
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "METTL3",
          "beacon:predicate": "overexpressing",
          "beacon:object": "T. annulata -infected leukocytes",
          "beacon:evidence": "reduction in proliferation in METTL3-overexpressing T. annulata -infected leukocytes"
        },
        {
