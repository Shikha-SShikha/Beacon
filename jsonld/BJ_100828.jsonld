    {
      "@type": "schema:WebPageElement",
      "beacon:chunkId": "article-10-1016-j-bj-2025-100828-sec3-p7",
      "beacon:sectionType": "results",
      "schema:text": "This results section from the study investigates the correlation between m6A methylation and gene expression in BL20 and TBL20 samples, highlighting a significant overlap in genes modified by m6A in both parasite-infected leukocyte types.\n\nIn our analysis, for both BL20 and TBL20 samples, we focused on the top 5% of genes showcasing the highest ratio of m6A modification relative to reference samples, postulating that this subset represents genes that undergo m6A methylation. Remarkably, considerable overlap was observed between these gene subsets, indicating that genes modified by m6A in BL20 are frequently modified similarly in TBL20. This observation aligns well with our previous approach.",
      "schema:name": "Results:",
      "beacon:subsectionTitle": "Association Between m6A Methylation and Differential Gene Expression",
      "schema:mentions": [
        {
          "@type": "schema:Thing",
          "schema:name": "BL20",
          "beacon:entityType": "CELL_LINE",
          "@id": "https://www.cellosaurus.org/CVCL_L859"
        },
        {
