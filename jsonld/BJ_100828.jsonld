          "beacon:entityType": "CELL_LINE"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "Nucleofector V",
          "beacon:entityType": "CHEMICAL",
          "@id": "http://purl.obolibrary.org/obo/CHEBI_16414"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "CRISPR",
          "beacon:entityType": "DRUG",
          "@id": "https://id.nlm.nih.gov/mesh/D000076987"
        }
      ],
      "beacon:relations": [
        {
          "@type": "beacon:Relation",
