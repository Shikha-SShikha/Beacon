        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "Theileria",
          "beacon:predicate": "reshape",
          "beacon:object": "the transcriptomes of infected cells",
          "beacon:evidence": "Theileria parasites reshape the transcriptomes of infected cells"
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "T. annulata",
