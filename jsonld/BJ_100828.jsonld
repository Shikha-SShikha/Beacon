    {
      "@type": "schema:WebPageElement",
      "beacon:chunkId": "article-10-1016-j-bj-2025-100828-sec3-p17",
      "beacon:sectionType": "results",
      "schema:text": "This Results section from a study on Theileria annulata explores how m6A RNA methylation impacts the migration abilities of infected macrophages, highlighting findings from Matrigel chamber assays regarding METTL3 overexpression.\n\nannulata -infected macrophages leads to its upregulation ( Figure 6 A). Based on these findings, we proposed that m6A RNA methylation might influence the dissemination potential of infected macrophages. We employed Matrigel chamber assays, which revealed that METTL3 overexpression reinforces the ability of infected macrophages to migrate through a synthetic matrix ( Figure. 6 B). Collectively, these results suggest that m6A modifications may enhance the dissemination ability of T. annulata -infected macrophages, potentially through the increased expression of ADAM19 mRNA.",
      "schema:name": "Results:",
      "beacon:subsectionTitle": "m 6 A Modulates Dissemination in Theileria -Transformed Leukocytes",
      "schema:mentions": [
        {
          "@type": "schema:Thing",
          "schema:name": "Theileria annulata",
          "beacon:entityType": "ORGANISM"
        },
        {
          "@type": "schema:Thing",
