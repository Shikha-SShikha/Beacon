          "beacon:subject": "TBL20",
          "beacon:predicate": "is_different_from",
          "beacon:object": "BL20",
          "beacon:evidence": "m6A levels differ between the more proliferative Theileria -infected B cells (TBL20) and their uninfected counterparts, BL20."
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "merozoite-producing macrophages",
          "beacon:predicate": "exhibits",
          "beacon:object": "unique methylation patterns",
          "beacon:evidence": "proliferation-arresting merozoite-producing macrophages exhibited unique methylation patterns."
        }
