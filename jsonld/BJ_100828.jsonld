          "beacon:predicate": "is",
          "beacon:object": "an intracellular protozoan",
          "beacon:evidence": "Theileria annulata is an intracellular protozoan and a member of the phylum Apicomplexa."
        },
        {
          "@type": "beacon:Relation",
