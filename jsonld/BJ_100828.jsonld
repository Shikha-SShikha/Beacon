          "beacon:object": "uncontrolled proliferation",
          "beacon:evidence": "altering the phenotype of host leukocytes, leading to uncontrolled proliferation."
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "T. annulata",
          "beacon:predicate": "leads to",
          "beacon:object": "apoptosis resistance",
