          "beacon:entityType": "CHEMICAL"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "7500 HT Fast Real-Time PCR System",
          "beacon:entityType": "EQUIPMENT"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "Applied Biosystems",
          "beacon:entityType": "ORGANISM"
        }
      ],
      "beacon:relations": [
        {
          "@type": "beacon:Relation",
          "beacon:subject": "GAPDH",
          "beacon:predicate": "serves",
          "beacon:object": "reference gene",
          "beacon:evidence": "GAPDH served as a reference gene"
        }
      ]
    },
    {
      "@type": "schema:WebPageElement",
      "beacon:chunkId": "article-10-1016-j-bj-2025-100828-sec2-p7",
      "beacon:sectionType": "methods",
      "schema:text": "This Materials and Methods section from the study describes the use of GAPDH as a reference gene and outlines the cell cycle analysis of Theileria-infected macrophages, detailing the transfection process and cell preparation for flow cytometry.\n\nGAPDH served as a reference gene, and results were evaluated via the 2 −ΔΔCT method with three biological replicates. Cell Cycle Analysis using Flow Cytometry: Theileria -infected macrophages, transfected with METTL3 CRISPR activation or a negative control plasmid, were seeded into 6-well plates and cultured for 48 h. Subsequently, cells were centrifuged and rinsed twice with cold PBS before being fixed in 70% pre-chilled ethanol overnight at -20°C. After fixation, cells were washed again with cold PBS, then stained with a solution containing PI (50 μg/mL) and RNase A (100 μg/mL), for 30 min at 4°C, protected from light. The stained cells were then analyzed using a flow cytometer (BD LSR Fortessa). Cell populations in the sub-G1 (G0), G1, S, and G2/M phases were categorized and analyzed based on their DNA content using the BD FACSDiva™ Software (BD Biosciences).",
      "schema:name": "Materials and Methods",
      "schema:mentions": [
        {
          "@type": "schema:Thing",
          "schema:name": "GAPDH",
          "beacon:entityType": "GENE",
          "@id": "https://www.ncbi.nlm.nih.gov/gene/2597"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "Theileria",
          "beacon:entityType": "ORGANISM",
          "@id": "https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?id=5873"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "METTL3",
          "beacon:entityType": "GENE",
          "@id": "https://www.ncbi.nlm.nih.gov/gene/56339"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "PI",
          "beacon:entityType": "CHEMICAL",
          "@id": "https://id.nlm.nih.gov/mesh/D051549"
        }
      ],
      "beacon:relations": [
        {
          "@type": "beacon:Relation",
          "beacon:subject": "GAPDH",
          "beacon:predicate": "serves",
          "beacon:object": "reference gene",
