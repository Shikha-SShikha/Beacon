          "beacon:entityType": "CHEMICAL"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "l-glutamine",
          "beacon:entityType": "CHEMICAL",
          "@id": "http://purl.obolibrary.org/obo/CHEBI_18050"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "Hepes",
          "beacon:entityType": "CHEMICAL",
          "@id": "https://id.nlm.nih.gov/mesh/D006531"
        },
        {
          "@type": "schema:Thing",
